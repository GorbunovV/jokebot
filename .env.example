TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# Which translator to use: deepl | claude
TRANSLATION_PROVIDER=deepl

# DeepL (used when TRANSLATION_PROVIDER=deepl)
DEEPL_API_KEY=
DEEPL_CONTEXT=Dark humor joke in informal Russian, keep punchline timing
DEEPL_TARGET_LANG=RU

# Claude (used when TRANSLATION_PROVIDER=claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_CONTEXT=Dark humor joke. Translate into informal Russian, keep punchline timing and wordplay.
CLAUDE_TARGET_LANG=Russian

STORAGE_PATH=./storage/sent-jokes.json
JOKE_API_CATEGORY=Dark
MAX_API_RETRIES=3
MAX_DUPLICATE_RETRIES=10
